  "description": "Butsa Bot",
  "engines": {
    "node": ">=24.9.0",
    "npm": ">=11"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "config": "^5.0.1",
    "email-templates": "^13.0.1",
    "ejs": "^6.0.1",
    "lodash": "^4.18.1",
    "nodemailer": "^9.1.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
